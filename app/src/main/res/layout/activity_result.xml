<?xml version="1.0" encoding="utf-8"?>

<!-- Root: scrollable container for the result screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Main content container: vertical stack of the header and result cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header: screen title and challenge subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_result_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_heading"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:fontFamily="monospace"
                android:text="@string/challenge_subtitle_mock"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
