<?xml version="1.0" encoding="utf-8"?>

<!-- Root: scrollable container for the opening screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Main content container: vertical stack of cards and the action button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Card 01: opponent of the day -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:background="@drawable/card_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <ImageView
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:contentDescription="@string/label_opponent_of_the_day"
                android:src="@mipmap/ic_launcher" />

            <!-- Text block: opponent label and username -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_opponent_of_the_day"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/opponent_username_mock"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_heading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duel_status_mock"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

            </LinearLayout>


        </LinearLayout>


    </LinearLayout>
</ScrollView>